#: templates/screen-home.php:17
#, php-format
msgid "Hello, %s"
msgstr "Olá, %s"

#: templates/screen-home.php:21
msgid "Your screens"
msgstr "Suas telas"

#: templates/screen-home.php:22
msgid "Nothing here yet. The screens other plugins add to the app appear here."
msgstr "Nada aqui ainda. As telas que outros plugins acrescentam ao app aparecem aqui."

#. Plugin header: Description
msgid "Turns the site into an installable app: a home-screen icon, an app shell for signed-in users and screens other plugins register."
msgstr "Transforma o site em um app instalável: um ícone na tela inicial, uma estrutura de app para quem está conectado e telas que outros plugins registram."

