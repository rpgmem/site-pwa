#. translators: %s: the signed-in user's first name
#: templates/screen-home.php:20
#, php-format
msgid "Hello, %s"
msgstr "Olá, %s"

#: templates/screen-home.php:24
msgid "Your screens"
msgstr "Suas telas"

#: templates/screen-home.php:26
msgid "Nothing here yet. The screens other plugins add to the app appear here."
msgstr "Nada aqui ainda. As telas que outros plugins acrescentam ao app aparecem aqui."

#: templates/screen-home.php:42 templates/site-banner.php:24
msgid "Not now"
msgstr "Agora não"

#: templates/screen-home.php:45
msgid "Install the app"
msgstr "Instale o app"

#: templates/screen-home.php:47
msgid "Open it from your home screen, full screen, like any other app."
msgstr "Abra pela tela inicial, em tela cheia, como qualquer outro app."

#: templates/screen-home.php:51
msgid "Install app"
msgstr "Instalar app"

#: templates/screen-home.php:56
msgid "Add it to your home screen to open it like any other app:"
msgstr "Adicione à tela de início para abrir como qualquer outro app:"

#: templates/screen-home.php:60
msgid "Tap Share in Safari’s toolbar."
msgstr "Toque em Compartilhar, na barra do Safari."

#: templates/screen-home.php:64
msgid "Choose Add to Home Screen."
msgstr "Escolha Adicionar à Tela de Início."

#: templates/screen-missing.php:16
msgid "This page is not available"
msgstr "Esta página não está disponível"

#: templates/screen-missing.php:18
msgid "It may have been removed, or you may not have access to it."
msgstr "Ela pode ter sido removida, ou você pode não ter acesso a ela."

#: templates/screen-missing.php:19
msgid "Back to the home screen"
msgstr "Voltar à tela inicial"

