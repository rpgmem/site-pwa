msgstr "Sem conexão"

#: templates/offline.php:25
msgid "This page needs the internet. Check the connection and try again."
msgstr "Esta página precisa de internet. Confira a conexão e tente de novo."

#: templates/offline.php:26
msgid "Try again"
msgstr "Tentar de novo"

#: templates/screen-account.php:18
