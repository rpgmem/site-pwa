#: src/admin/settings-page.php:59 src/admin/settings-page.php:60
#: src/admin/settings-page.php:94
msgid "Site PWA"
msgstr "Site PWA"

#. translators: %s: plugin names, comma-separated
#: src/admin/settings-page.php:102
#, php-format
msgid "Also registering a service worker at the site root: %s. A browser keeps only one there, so the two would replace each other on every visit."
msgstr "Também registra um service worker na raiz do site: %s. O navegador mantém só um ali, então os dois se substituiriam a cada visita."

#: src/admin/settings-page.php:111
msgid "The app stays off until you confirm the replacement below, or that plugin is deactivated."
msgstr "O app fica desligado até você confirmar a substituição abaixo, ou até esse plugin ser desativado."

#: src/admin/settings-page.php:113
msgid "Replacement confirmed: the app's worker takes the root, and that plugin's worker stops working."
msgstr "Substituição confirmada: o worker do app ocupa a raiz, e o worker desse plugin deixa de funcionar."

#: src/admin/settings-page.php:120
msgid "This browser already has another service worker for this site:"
msgstr "Este navegador já tem outro service worker para este site:"

#: src/admin/settings-page.php:122
msgid "Turning the app on replaces it. Confirm the replacement below to continue."
msgstr "Ligar o app o substitui. Confirme a substituição abaixo para continuar."

#: src/admin/settings-page.php:127
msgid "The app is on at"
msgstr "O app está ligado em"

#: src/admin/settings-page.php:136 templates/frame.php:35
#: templates/site-banner.php:17
msgid "App"
msgstr "App"

#: src/admin/settings-page.php:140
msgid "Turn the installable app on"
msgstr "Ligar o app instalável"

#: src/admin/settings-page.php:142
msgid "While it is off, the site serves no manifest, and a browser that installed the app removes its service worker on its next visit."
msgstr "Enquanto estiver desligado, o site não oferece o manifest, e um navegador que instalou o app remove o service worker na próxima visita."

#: src/admin/settings-page.php:146
msgid "Other service workers"
msgstr "Outros service workers"

#: src/admin/settings-page.php:150
msgid "Replace another plugin's service worker"
msgstr "Substituir o service worker de outro plugin"

#: src/admin/settings-page.php:152
msgid "Only needed when another plugin registers a worker at the site root. A push service that wants to keep working can load its script through the site_pwa_sw_imports filter instead."
msgstr "Só é necessário quando outro plugin registra um worker na raiz do site. Um serviço de push que precise continuar funcionando pode, em vez disso, carregar o próprio script pelo filtro site_pwa_sw_imports."

#: src/admin/settings-page.php:156 templates/screen-account.php:20
msgid "Name"
msgstr "Nome"

#: src/admin/settings-page.php:160
msgid "Short name"
msgstr "Nome curto"

#: src/admin/settings-page.php:163
msgid "Shown under the icon on a home screen."
msgstr "Aparece sob o ícone na tela inicial."

#: src/admin/settings-page.php:167
msgid "Invite to the app"
msgstr "Convite para o app"

#: src/admin/settings-page.php:172
msgid "Show a \"Use the app\" banner on the site's pages"
msgstr "Mostrar a faixa \"Use o app\" nas páginas do site"

#: src/admin/settings-page.php:174
msgid "Only on phones and tablets, only to signed-in visitors, and never inside the installed app. A visitor who closes it does not see it again on that device for 30 days. The app's home screen invites to install it the same way."
msgstr "Só em celulares e tablets, só para visitantes conectados, e nunca dentro do app instalado. Quem fecha a faixa não a vê de novo naquele aparelho por 30 dias. A tela inicial do app convida para instalá-lo da mesma forma."

#: src/admin/settings-page.php:178
msgid "Look"
msgstr "Aparência"

#: src/admin/settings-page.php:181
msgid "These settings"
msgstr "Estas configurações"

#: src/admin/settings-page.php:186
msgid "Where the app takes its accent colour and its corners from. While the chosen design is switched off, or its plugin is inactive, the app uses the theme colour below."
msgstr "De onde o app tira a cor de destaque e os cantos. Enquanto o design escolhido estiver desligado, ou o plugin dele estiver inativo, o app usa a cor do tema abaixo."

#. translators: 1: a colour such as #1d5e8c, 2: corner radius of cards in px, 3: corner radius of buttons in px
#: src/admin/settings-page.php:193
#, php-format
msgid "In use now: accent %1$s, cards %2$d px, buttons %3$d px."
msgstr "Em uso agora: destaque %1$s, cartões %2$d px, botões %3$d px."

#: src/admin/settings-page.php:204
msgid "Theme colour"
msgstr "Cor do tema"

#: src/admin/settings-page.php:208
msgid "Background colour"
msgstr "Cor de fundo"

#: src/admin/settings-page.php:211
msgid "Shown while the app opens."
msgstr "Aparece enquanto o app abre."

#: src/admin/settings-page.php:215
msgid "Icon"
msgstr "Ícone"

#: src/admin/settings-page.php:216
msgid "The app uses the site icon from Settings → General; without one, it uses the plugin's icon."
msgstr "O app usa o ícone do site, de Configurações → Geral; sem ele, usa o ícone do plugin."

